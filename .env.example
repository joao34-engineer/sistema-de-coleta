# Origem publica (QR/verificacao no PDF e link /d/{token}). Obrigatoria para o render in-process.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only no Next (Vercel): rate-limit RPC + worker de documentos.
# Nunca NEXT_PUBLIC_*. Nunca expor ao cliente. Nunca commitar o valor real.
# Tambem usada por scripts/bootstrap-admin.ts no terminal local.
SUPABASE_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CONFIRM_PROJECT_REF=

# Server-only. Deve coincidir com o project ref do host de NEXT_PUBLIC_SUPABASE_URL.
# Nunca expor ao cliente nem commitar valores reais.
SUPABASE_CONFIRM_PROJECT_REF=
DOCUMENT_RATE_LIMIT_SECRET=
# Rota interna + cron (retry). O celular / finalize in-process nao usa estes secrets.
# Worker manual (curl POST/GET): header X-Document-Worker-Secret. Minimo 32 chars.
DOCUMENT_WORKER_SECRET=
# Vercel Cron: Authorization Bearer automatico. Minimo 32 chars. Nao commitar.
CRON_SECRET=

# Alerta opcional de 500 (somente https). Ausente = so log JSON.
ERROR_ALERT_WEBHOOK_URL=

# E-mail de share (V1): dry-run por padrao e em NODE_ENV=test.
# Envio real so com DOCUMENT_EMAIL_SEND_ENABLED=true + RESEND_API_KEY + DOCUMENT_FROM_EMAIL.
# NEXT_PUBLIC_APP_URL e a origem usada no link /d/{token} do e-mail.
DOCUMENT_EMAIL_SEND_ENABLED=
RESEND_API_KEY=
DOCUMENT_FROM_EMAIL=

# Backup Chat 5 — bundle fora do repo. Nunca commitar dumps.
BACKUP_OUTPUT_DIR=
BACKUP_INPUT_DIR=

# Restore isolado (throwaway). Nunca iguais ao MVP. Nunca na Vercel.
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SECRET_KEY=
RESTORE_CONFIRM_PROJECT_REF=
RESTORE_DATABASE_URL=
